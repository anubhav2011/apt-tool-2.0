# ============================================================================
# AI PROCTORING SYSTEM - Environment Variables (Essential Settings Only)
# ============================================================================
# Accuracy thresholds are configured in config.py detection config classes:
#   - MediaPipeDetectionConfig (for DETECTION_CLIENT=mediapipe)
#   - IntelDetectionConfig (for DETECTION_CLIENT=intel)
# Switching clients automatically activates the appropriate thresholds.

# ── Detection Client Selection ────────────────────────────────────────────
DETECTION_CLIENT=mediapipe

# ── Intel OpenVINO Settings (only needed if DETECTION_CLIENT=intel) ───────
INTEL_DEVICE=CPU
INTEL_PRECISION=FP32

# ── Database Configuration ────────────────────────────────────────────────
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=proctoring

# ── S3 Configuration ──────────────────────────────────────────────────────
S3_BUCKET_NAME=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
S3_PREFIX_ROOT=data/recording-assets/ai/beam

# ── Scheduler Configuration ───────────────────────────────────────────────
SCHEDULER_INTERVAL_SECONDS=3600
SCHEDULER_TIMEZONE=UTC
SCHEDULER_JOB_COALESCE=true
SCHEDULER_JOB_MAX_INSTANCES=1
SCHEDULER_MIN_INTERVIEW_CREATED_DATE=

# ── Authentication ────────────────────────────────────────────────────────
AUTH_USERNAME=admin
AUTH_PASSWORD=strong_password

# ── Logging ───────────────────────────────────────────────────────────────
LOG_FILE=debug_logs/debug_logs.log
DEBUG=false
