# ════════════════════════════════════════════════════════════════════════════════
# Environment Configuration for AI Proctoring System
# ════════════════════════════════════════════════════════════════════════════════

# ── General ──────────────────────────────────────────────────────────────────────
DEBUG=false
LOG_FILE=debug_logs/debug_logs.log

# ── Database (MySQL/MariaDB) ─────────────────────────────────────────────────────
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=proctoring

# ── AWS S3 (Video Evidence Storage) ──────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
S3_BUCKET_NAME=
S3_PREFIX_ROOT=data/recording-assets/ai/beam

# ── Authentication ───────────────────────────────────────────────────────────────
AUTH_USERNAME=admin
AUTH_PASSWORD=strong_password

# ── Scheduler ────────────────────────────────────────────────────────────────────
SCHEDULER_INTERVAL_SECONDS=3600
SCHEDULER_TIMEZONE=UTC
SCHEDULER_JOB_COALESCE=true
SCHEDULER_JOB_MAX_INSTANCES=1
SCHEDULER_MIN_INTERVIEW_CREATED_DATE=

# ════════════════════════════════════════════════════════════════════════════════
# Detection Client Selection
# ════════════════════════════════════════════════════════════════════════════════

# Options: mediapipe (default), intel
DETECTION_CLIENT=mediapipe

# ════════════════════════════════════════════════════════════════════════════════
# Intel OpenVINO Model Configuration
# ════════════════════════════════════════════════════════════════════════════════

# Device: CPU (default), GPU, AUTO, etc.
INTEL_DEVICE=CPU

# Model precision: FP32 (default, best accuracy), FP16 (faster, slight loss), INT8 (faster, more loss)
INTEL_PRECISION=FP32

# Auto-download location (relative to app/client/detection/)
INTEL_MODELS_DIR=intel

# Optional: override specific model paths (leave blank to auto-resolve)
INTEL_FACE_MODEL_XML=
INTEL_LANDMARKS_MODEL_XML=
INTEL_HEAD_POSE_MODEL_XML=
INTEL_GAZE_MODEL_XML=

# ════════════════════════════════════════════════════════════════════════════════
# Detection Accuracy Tuning (applies to both MediaPipe and Intel)
# ════════════════════════════════════════════════════════════════════════════════

# Minimum detection confidence for face detection (0.0 - 1.0)
# Higher = stricter, fewer false positives but more misses in poor lighting
# Intel default: 0.6, MediaPipe default: 0.7
DETECTION_MIN_CONFIDENCE=0.65

# Minimum tracking confidence (0.0 - 1.0)
# Higher = more stable tracking but slower to re-detect after occlusion
# Intel default: 0.5, MediaPipe default: 0.7
DETECTION_MIN_TRACKING_CONFIDENCE=0.65

# Eye aspect ratio (EAR) threshold for detecting open/closed eyes
# Lower = more sensitive to eye closure (detects blinks easier)
# Intel/MediaPipe default: 0.18 (tuned for accuracy)
EYE_ASPECT_RATIO_THRESHOLD=0.18

# Gaze angle estimation confidence multiplier (Intel-specific tuning)
# Values > 1.0 boost gaze confidence, < 1.0 reduce it for conservative accuracy
GAZE_CONFIDENCE_MULTIPLIER=1.0

# Head pose estimation confidence multiplier (Intel-specific tuning)
POSE_CONFIDENCE_MULTIPLIER=1.0

# ════════════════════════════════════════════════════════════════════════════════
# OpenVINO Model Download Configuration
# ════════════════════════════════════════════════════════════════════════════════

# Enable/disable auto-download on server startup
INTEL_AUTO_DOWNLOAD=true

# Fallback: if omz_downloader fails, download directly from this URL
# (Intel OMZ GitHub raw content CDN)
INTEL_MODEL_REPOSITORY_URL=https://raw.githubusercontent.com/openvinotoolkit/open_model_zoo/2024.5.0/models_intel

# Timeout for model download (seconds)
INTEL_DOWNLOAD_TIMEOUT=300

# ════════════════════════════════════════════════════════════════════════════════
# Performance Tuning (Both clients)
# ════════════════════════════════════════════════════════════════════════════════

# Maximum frame dimension for processing (larger = more accurate but slower)
MAX_FRAME_DIMENSION=1280

# Target FPS for video processing (lower = fewer frames analyzed but faster)
TARGET_FPS=18

# Warmup frames before triggering violations (allows system to stabilize)
WARMUP_SECONDS=3.0

# ════════════════════════════════════════════════════════════════════════════════
# TVT (Temporal Vision Transformer) - Optional AI Model for Violation Confirmation
# ════════════════════════════════════════════════════════════════════════════════

ENABLE_TVT=false
TVT_TEMPORAL_WINDOW=24
TVT_CPU_OPTIMIZED=true
TVT_PROB_THRESHOLD=0.85
TVT_INFERENCE_INTERVAL_SEC=1.0
